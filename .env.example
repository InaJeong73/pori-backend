# ── Local (Docker Compose) ────────────────────────────────────────────────────
POSTGRES_DB=pori
POSTGRES_USER=user
POSTGRES_PASSWORD=change_me

DB_URL=jdbc:postgresql://localhost:5432/pori
DB_USERNAME=user
DB_PASSWORD=change_me

# ── Cloud Run + Cloud SQL ─────────────────────────────────────────────────────
# Cloud Run에서는 아래 형식으로 DB_URL 환경변수를 설정하세요.
# DB_URL=jdbc:postgresql:///pori?cloudSqlInstance=PROJECT_ID:REGION:INSTANCE_NAME&socketFactory=com.google.cloud.sql.postgres.SocketFactory
# DB_USERNAME=your_db_user
# DB_PASSWORD=your_db_password

# ── 공통 ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://pori-five.vercel.app
CORS_ALLOWED_ORIGIN_PATTERNS=https://pori-be-*.asia-northeast3.run.app
